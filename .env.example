# ==============================================================================
# JoharSetu (जोहारसेतु) Environment Configuration Example
# Copy this file to .env and fill in your values
# ==============================================================================

# ── 1. Primary Relational & PostGIS Database (Supabase PostgreSQL SSOT) ────────
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"

# ── 2. Client & Auth Configuration (Next.js PWA) ──────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_super_secret_key"
JWT_SECRET="your_secure_jwt_secret_key"

# ── 3. Google Maps GIS JavaScript API ─────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"
VITE_GOOGLE_MAPS_API_KEY="your_google_maps_api_key"

# ── 4. Python FastAPI AI & Spatial Routing Microservice (Port 8000) ────────────
FASTAPI_SERVICE_URL="http://localhost:8000"
NEXT_PUBLIC_FASTAPI_URL="http://localhost:8000"
QDRANT_HOST="localhost"
QDRANT_PORT=6333

# ── 5. Express & Groq Multilingual Chat Microservice (Port 5000) ──────────────
PORT=5000
NEXT_PUBLIC_CHAT_SERVICE_URL="http://localhost:5000"
MONGO_URI="mongodb://localhost:27017/joharsetu_chat"

# AI Inference Keys (Groq Cloud & Google Gemini)
GROQ_CLOUD_API="your_groq_api_key"
GEMINI_API_KEY="your_gemini_api_key"

# Cloud Cache & Vector Search (Upstash Redis & Pinecone)
REDIS_URL="rediss://default:[PASSWORD]@[HOST]:6379"
PINECONE_API_KEY="your_pinecone_api_key"
PINECONE_INDEX="sih"

# Cloudinary Evidence Storage
CLOUDINARY_NAME="your_cloudinary_cloud_name"
CLOUDINARY_API_KEY="your_cloudinary_api_key"
CLOUDINARY_API_SECRET="your_cloudinary_api_secret"

# Notification Transporter (Nodemailer)
EMAIL="your_email@gmail.com"
EMAIL_PASSWORD="your_email_app_password"

