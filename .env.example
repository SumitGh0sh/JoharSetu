# ── 7. Web3 Blockchain Layer & Polygon Amoy Testnet (Chain ID: 80002) ───────────
# Public RPC: https://rpc-amoy.polygon.technology or Alchemy / Infura endpoint
POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
NEXT_PUBLIC_POLYGON_AMOY_RPC_URL="https://rpc-amoy.polygon.technology"
POLYGON_AMOY_CHAIN_ID=80002

# Relayer Gasless Private Key (Hex without or with 0x prefix) - used to anchor transactions
RELAYER_PRIVATE_KEY=""
POLYGONSCAN_API_KEY=""

# Deployed Smart Contract Addresses (Populated by `npm run deploy:contracts`)
NEXT_PUBLIC_CIVIC_AUDIT_LEDGER_ADDRESS="0x5FbDB2315678afecb367f032d93F642f64180aa3"
